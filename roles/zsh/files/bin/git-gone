#!/usr/bin/env bb
;; -*- mode: clojure; -*-

(ns util
  (:require
    [clojure.java.shell :as shell]
    [clojure.string :as str]))


(defn sh
  [& args]
  (println "+" (str/join " " args))
  (let [{:keys [exit out err]} (apply shell/sh args)]
    (if (not= 0 exit) (throw (Exception. err)) :ok)
    (println out)
    out))


(defn peco
  [{:keys [prompt]} input]
  (if (seq input)
    (let [{:keys [exit out err]} (shell/sh "peco" "--prompt" prompt :in (str/join "\n" input))]
      (if (not= 0 exit) (throw (Exception. err)) :ok)
      (filter #(not= "" %) (str/split-lines out)))
    []))


(ns git
  (:require
    [clojure.string :as str]
    [util]))


(defn branch-
  ([branch] {:branch branch :remote nil})
  ([branch remote] {:branch branch :remote remote}))


(defn branch-from-str
  [s]
  (let [[fst snd] (str/split s #"/" 2)]
    (if (nil? snd)
      (branch- fst)
      (branch- snd fst))))


(defn branch-to-str
  [{:keys [branch remote]}]
  (if (nil? remote)
    branch
    (str remote "/" branch)))


(defn current-upstream-branch
  []
  (if-let [line (first (str/split-lines (util/sh "sh"
                                                 "-c"
                                                 "git rev-parse --abbrev-ref --symbolic-full-name @{u} 2> /dev/null || true")))]
    (branch-from-str line)
    nil))


(defn checked-out-line?
  "Whether a `git branch` line is checked out in the current (`*`) or another (`+`) worktree."
  [line]
  (or (str/starts-with? line "*")
      (str/starts-with? line "+")))


(defn local-merged-branches
  []
  (->> (util/sh "git" "branch" "--merged")
       (str/split-lines)
       (filter (fn [line]
                 (and (not (checked-out-line? line))
                      (not (str/ends-with? line " main"))
                      (not (str/ends-with? line " master"))
                      (not (str/ends-with? line " develop")))))
       (map str/triml)
       (map #(branch- %))))


(defn protected-branch?
  [branch]
  (contains? #{"main" "master" "develop"} branch))


(defn strip-branch-marker
  [line]
  (str/replace line #"^[*+]?\s+" ""))


(defn merged-branch-names
  "HEAD にmerge濟みのbranch名。いづれかのworktreeでcheckout中のものも含む。"
  []
  (->> (util/sh "git" "branch" "--merged")
       (str/split-lines)
       (map strip-branch-marker)
       (set)))


(defn gone-branch-names
  "upstreamが消えたbranch名。いづれかのworktreeでcheckout中のものも含む。"
  []
  (->> (util/sh "git" "branch" "-vv")
       (str/split-lines)
       (filter #(str/includes? % ": gone]"))
       (map #(first (str/split (strip-branch-marker %) #"\s+")))
       (set)))


(defn worktrees
  "`git worktree list --porcelain` を [{:path :branch :locked? :detached? :bare?}] に變換する。"
  []
  (->> (str/split (util/sh "git" "worktree" "list" "--porcelain") #"\n\n")
       (map str/split-lines)
       (filter seq)
       (map (fn [lines]
              (reduce (fn [acc line]
                        (cond
                          (str/starts-with? line "worktree ") (assoc acc :path (subs line 9))
                          (str/starts-with? line "branch refs/heads/") (assoc acc :branch (subs line 18))
                          (str/starts-with? line "locked") (assoc acc :locked? true)
                          (= line "detached") (assoc acc :detached? true)
                          (= line "bare") (assoc acc :bare? true)
                          :else acc))
                      {}
                      lines)))))


(defn dirty-worktree?
  [{:keys [path]}]
  (not (str/blank? (util/sh "git" "-C" path "status" "--porcelain"))))


(defn removable-worktrees
  "branchがmerge濟みまたはgoneのworktree。main worktreeと現在のworktreeは除く。"
  []
  (let [top (str/trim (util/sh "git" "rev-parse" "--show-toplevel"))
        merged (merged-branch-names)
        gone (gone-branch-names)]
    (->> (rest (worktrees))
         (remove (fn [{:keys [path branch locked? detached? bare?]}]
                   (or (= top path) locked? detached? bare? (nil? branch) (protected-branch? branch))))
         (keep (fn [{:keys [branch] :as w}]
                 (cond
                   (contains? merged branch) (assoc w :why "merged")
                   (contains? gone branch) (assoc w :why "gone"))))
         (remove dirty-worktree?))))


(defn select-worktrees
  []
  (let [candidates (removable-worktrees)
        by-path (into {} (map (juxt :path identity)) candidates)]
    (->> candidates
         (map (fn [{:keys [path branch why]}] (str path "\t" branch "\t[" why "]")))
         (util/peco {:prompt "WORKTREE>"})
         (map #(get by-path (first (str/split % #"\t"))))
         (remove nil?))))


(defn remove-worktree
  [{:keys [path]}]
  (try
    (util/sh "git" "worktree" "remove" path)
    (catch Exception e
      (println "skip:" path (.getMessage e)))))


(defn local-force-removable-branches
  []
  (->> (util/sh "git" "branch" "-vv")
       (str/split-lines)
       (filter (fn [line]
                 (and (not (checked-out-line? line))
                      (not (str/includes? line " main "))
                      (not (str/includes? line " master "))
                      (not (str/includes? line " develop "))
                      (str/includes? line ": gone]"))))
       (map str/triml)
       (util/peco {:prompt "LOCAL>"})
       (map #(branch- (first (str/split % #"\s+"))))))


(defn remote-force-removable-branches
  []
  (let [current-upstream-br (current-upstream-branch)]
    (->> (util/sh "git" "branch" "-r" "--merged")
         (str/split-lines)
         (filter (fn [line]
                   (and (not (str/includes? line "/HEAD "))
                        (not (str/ends-with? line "/main"))
                        (not (str/ends-with? line "/master"))
                        (not (str/ends-with? line "/develop"))
                        (if current-upstream-br
                          (not (str/ends-with? line (branch-to-str current-upstream-br)))
                          true))))
         (map str/triml)
         (util/peco {:prompt "REMOTE>"})
         (map #(branch-from-str (first (str/split % #"\s+")))))))


(defn delete-branch
  [{:keys [branch remote]}]
  (if (nil? remote)
    (util/sh "git" "branch" "-d" branch)
    ""))


(defn delete-branch-force
  [{:keys [branch remote]}]
  (if (nil? remote)
    (util/sh "git" "branch" "-D" branch)
    (util/sh "git" "push" "-d" remote branch)))


(ns user
  (:require
    [git]
    [util]))


(defn delete-worktrees-interactively
  []
  (util/sh "git" "worktree" "prune")
  (doseq [worktree (git/select-worktrees)]
    (git/remove-worktree worktree)))


(defn delete-local-merged-branches
  []
  (doseq [branch (git/local-merged-branches)]
    (git/delete-branch branch)))


(defn delete-local-branches-interactively
  []
  (doseq [branch (git/local-force-removable-branches)]
    (git/delete-branch-force branch)))


(defn delete-remote-branches-interactively
  []
  (doseq [branch (git/remote-force-removable-branches)]
    (git/delete-branch-force branch)))


(defn -main
  []
  (delete-worktrees-interactively)
  (delete-local-merged-branches)
  (delete-local-branches-interactively)
  (delete-remote-branches-interactively)
  (util/sh "git" "gc" "--auto" "--prune"))


(-main)
